{
  "enableAnalytics": false,
  "enableInstallTelemetry": false,
  "retry": { "maxRetries": 10 },

  "theme": "random",
  "themes": ["random-hue/random.json"],
  "quietStartup": true,

  "skills": [
    "~/.claude/skills",
    "~/.codex/skills"
  ],

  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@sting8k/pi-vcc",
    "npm:pi-footer",
    "npm:pi-herdsman",
    "npm:pi-lens",
    "npm:pi-web-access",

    {
      "skills": [
        "skills/engineering/**",
        "!skills/engineering/code-review/**",
        "skills/productivity/**"
      ],
      "source": "git:https://github.com/mattpocock/skills"
    }
  ]
}
